generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "cjs"
  generatedFileExtension = "cts"
  importFileExtension    = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String                     @id @default(cuid())
  email                  String                     @unique
  fullName               String
  passwordHash           String?
  phone                  String?
  addressLine            String?
  city                   String?
  postalCode             String?
  role                   UserRole                   @default(CUSTOMER)
  addresses              Address[]
  paymentMethods         SavedPaymentMethod[]
  orders                 Order[]
  notifications          Notification[]
  requestedCancellations OrderCancellationRequest[] @relation("CancellationRequester")
  reviewedCancellations  OrderCancellationRequest[] @relation("CancellationReviewer")
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt
}

model Address {
  id                 String   @id @default(cuid())
  userId             String
  label              String
  recipientFullName  String
  recipientEmail     String
  recipientPhone     String
  addressLine        String
  city               String
  postalCode         String
  isDefault          Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model SavedPaymentMethod {
  id               String        @id @default(cuid())
  userId           String
  type             PaymentMethod
  label            String
  isDefault        Boolean       @default(false)
  cardholderName   String?
  cardLast4        String?
  cardExpiryMonth  String?
  cardExpiryYear   String?
  bankName         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id          String      @id @default(cuid())
  name        String
  slug        String      @unique
  subtitle    String?
  description String
  howToUse    String      @default("")
  benefits    String[]    @default([])
  ingredients String[]    @default([])
  galleryImages String[]  @default([])
  imageUrl    String?
  isPublished Boolean     @default(false)
  isFlashSale Boolean     @default(false)
  price       Decimal     @db.Decimal(10, 2)
  compareAtPrice Decimal? @db.Decimal(10, 2)
  stock       Int         @default(0)
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id])
  orderItems  OrderItem[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model Order {
  id                  String      @id @default(cuid())
  orderNo             String      @unique
  userId              String
  user                User        @relation(fields: [userId], references: [id])
  status              OrderStatus @default(PENDING)
  refundStatus        RefundStatus @default(NONE)
  paymentMethod       PaymentMethod @default(QR_PAYMENT)
  paymentDemoStatus   PaymentDemoStatus @default(NOT_STARTED)
  paymentSubmittedAt  DateTime?
  paymentCompletedAt  DateTime?
  customerFullName    String?
  customerEmail       String?
  customerPhone       String?
  shippingAddressLine String?
  shippingCity        String?
  shippingPostalCode  String?
  subtotal            Decimal?    @db.Decimal(10, 2)
  shippingTotal       Decimal?    @db.Decimal(10, 2)
  total               Decimal     @db.Decimal(10, 2)
  items               OrderItem[]
  cancellationRequests OrderCancellationRequest[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
}

model OrderCancellationRequest {
  id               String                    @id @default(cuid())
  orderId          String
  requesterUserId  String
  reasonCode       CancellationReasonCode
  details          String?
  status           CancellationRequestStatus @default(REQUESTED)
  reviewNote       String?
  reviewedByUserId String?
  reviewedAt       DateTime?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  order            Order                     @relation(fields: [orderId], references: [id])
  requester        User                      @relation("CancellationRequester", fields: [requesterUserId], references: [id])
  reviewedBy       User?                     @relation("CancellationReviewer", fields: [reviewedByUserId], references: [id])

  @@index([orderId, createdAt])
  @@index([requesterUserId, createdAt])
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  productName    String?
  productSlug    String?
  productImageUrl String?
  quantity       Int
  unitPrice      Decimal  @db.Decimal(10, 2)
  order          Order    @relation(fields: [orderId], references: [id])
  product        Product  @relation(fields: [productId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  orderNo   String?
  titleEn   String
  titleTh   String
  bodyEn    String
  bodyTh    String
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum OrderStatus {
  PENDING
  PAID
  PACKING
  SHIPPED
  DELIVERED
  CANCELED
}

enum RefundStatus {
  NONE
  PENDING_MANUAL
  REFUNDED
}

enum PaymentMethod {
  QR_PAYMENT
  CARD
}

enum PaymentDemoStatus {
  NOT_STARTED
  QR_SUBMITTED
  CARD_COMPLETED
}

enum CancellationReasonCode {
  WRONG_ADDRESS
  DUPLICATE_ORDER
  CHANGED_MIND
  PAYMENT_ISSUE
  ORDER_DELAY
  OTHER
}

enum CancellationRequestStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum NotificationType {
  ORDER_CREATED
  QR_PAYMENT_SUBMITTED
  QR_PAYMENT_CONFIRMED
  CANCELLATION_REQUESTED
  CANCELLATION_APPROVED
  CANCELLATION_REJECTED
  REFUND_PENDING
  REFUND_COMPLETED
}
